# AGENT INSTRUCTION: If you modify this project, keep secrets out of git, preserve Pydantic validation, and do not hardcode credentials.
# AGENT INSTRUCTION: If you update runtime behavior, update backend/requirements.txt and backend/.env.example in the same change.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_PUBLIC_KEY=your_supabase_publishable_key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.1-flash
GEMINI_RETRY_COUNT=3
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_THINKING_LEVEL=medium
GRAPHITE_PORT=8001
FLASK_DEBUG=false
NOTES_DATABASE_PATH=./data/graphite.sqlite3
VOICE_INPUT_MODEL_PATH=./data/models/stt/voice-input-english-244.bin
KITTEN_MODEL_PATH=./data/models/tts/kitten_tts_mini_v0_8.onnx
KITTEN_MODEL_REPO=KittenML/kitten-tts-nano-0.8
MODEL_CACHE_DIR=./data/model-cache
GRAPHITE_MODEL_REPO=krishnah27/graphite
HUGGINGFACE_TOKEN=

# Repo-root .env is also supported with these alias names:
# superbase_api, superbase_pub_key, superbase_secret_key, gemini_api
